# 根目录白名单：增加新目录时，先更新 docs/repository-layout.md。
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/.github/
!/docs/
!/02-onnx-baseline/
!/04-lightweight/
!/common/
!/datasets/
!/compatibility/
!/assets/
!/reports/
!/第一阶段/

# 第一阶段只保留阶段入口与已确认的个人 SPEC；正文及过程记录使用统一 docs。
/第一阶段/*
!/第一阶段/README.md
!/第一阶段/docs/
/第一阶段/docs/*
!/第一阶段/docs/SPEC.md

# 原参考专著、原始团队文件和本地工作材料不上传。
/参考/
/SPEC/
/.local/
**/originals/

# 本地依赖、编辑器与缓存。
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db

# 训练、构建及运行产生的大文件。
**/outputs/
**/runs/
**/checkpoints/
**/build/
**/dist/
**/*.pt
**/*.pth
**/*.onnx
**/*.rknn
**/*.bin
**/*.npy
**/*.npz
**/*.mp4
**/*.avi
**/*.zip
**/*.7z
**/*.tar
**/*.gz
**/*.exe
**/*.dll
**/*.so
**/*.pdf

# 凭据、私人笔记、临时文件。
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.pfx
**/*_private.*
**/*.tmp
**/*.bak
**/~$*
