# 根目录白名单
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/.github/
!/docs/
!/02-onnx-baseline/
!/common/
!/datasets/
!/compatibility/
!/assets/
!/reports/
!/第一阶段/

/第一阶段/*
!/第一阶段/README.md
!/第一阶段/docs/
/第一阶段/docs/*
!/第一阶段/docs/SPEC.md

# 本地资料与依赖
/.local/
**/originals/
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db

# 数据、模型与运行产物
**/data/
**/model/
**/outputs/
**/runs/
**/checkpoints/
**/build/
**/dist/
**/*.pt
**/*.pth
**/*.onnx
**/*.bin
**/*.npy
**/*.npz
**/*.zip
**/*.7z
**/*.tar
**/*.gz
**/*.exe
**/*.dll
**/*.so
**/*.pdf

# 凭据与临时文件
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.pfx
**/*_private.*
**/*.tmp
**/*.bak
**/~$*
